---
import  Layout  from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths(){
    const projects = await getCollection("projects")
    return projects.map((project)=>({
        params : { id: project.id},
        props : {project}
    }))
};

const {project} = Astro.props
const {data} = project
const {title, description, img, link, technologies} = data

const { Content } = await render(project)
---


<Layout title=`${title} - John Antzoulis`>
    <div class="flex flex-col gap-12 items-center">
        <aside>
            <img src={img} alt={description} class="w-xs md:w-xl rounded-2xl">
        </aside>
        <main class="flex flex-col items-center gap-6 w-xs md:w-2xl">    
            <h1 class="text-4xl md:text-7xl ">{title}</h1>
            <article class="prose-sm md:prose-lg prose-dark"><Content /></article>
        </main>
    </div>
    

</Layout>