---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Techstack from '../components/Techstack.astro';
const projects = await getCollection("projects")

---

<Layout title="Home">
<main class="mx-auto w-full max-w-3xl px-6 py-6 gap-10 flex flex-col items-center">
	<section class="hero">
		<p class="text-blue-700 text-lg md:text-2xl">Hello, I'm</p>
		<h1 class="text-4xl md:text-7xl">John Antzoulis</h1>
		<p class=" text-sm md:text-xl">Full-stack web developer based in Spain</p>	
		<div class="flex gap-2">
			<p class="text-xs md:text-lg text-blue-500 animate-pulse">Open for work</p>
			<p class="text-xs md:text-lg text-blue-500 animate-pulse">Willing to relocate</p>
		</div>
		<div class="mt-3 flex gap-3 md:gap-6 items-center">
			<a aria-label="Curriculum redirect button" href="/CV.pdf" target="_blank" rel="noopener noreferrer" class="bg-blue-700 px-2 py-1 rounded-md text-sm md:text-xl md:px-4 md:py-2 md:rounded-lg hover:bg-blue-900 ease-in-out duration-100">View CV</a>
			<a aria-label="Github profile redirect button" href="https://github.com/JohnAntz" target="_blank" rel="noopener noreferrer" class="  hover:text-blue-900 ease-in-out duration-100"><Icon name="github" class="size-7 md:size-11"/></a>
			<a aria-label="Codeberg profile redirect button"  href="https://codeberg.org/JohnAntz" target="_blank" rel="noopener noreferrer" class="  hover:text-blue-900 ease-in-out duration-100"><Icon name="codeberg" class="size-7 md:size-11"/></a>
			<a aria-label="Linkedin profile redirect button" href="https://www.linkedin.com/in/john-antzoulis-657a413aa/?lipi=urn%3Ali%3Apage%3Ad_flagship3_profile_view_base_contact_details%3BuwJdq2hXT2i7qy8VQIDtAQ%3D%3D" target="_blank" rel="noopener noreferrer" class="  hover:text-blue-900 ease-in-out duration-100"><Icon name="linkedin" class="size-7 md:size-11"/></a>

			
		</div>	
	</section>
	<section class="tech-stack flex flex-col items-center gap-3 md:gap-7">
		<h1 class="text-2xl md:text-4xl">Tech-stack</h1>
		<Techstack/>
	</section>
	<section class="projects flex flex-col items-center">
		<h1 class="text-2xl md:text-4xl">Selected work</h1>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-10 p-5 justify-items-center">
			{
				projects.map(project => {
					const { id, data } = project
					const { title, description, img, link, technologies} = data
						return (
						<article class="bg-linear-to-r from-blue-700 from-15% via-transparent via-50% to-transparent to-85%  rounded-3xl p-0.5 shadow-[0_0_10px_4px_#1447e6]/30 max-w-sm w-full hover:scale-105 ease-in-out duration-150 ">
							<div class="bg-slate-950 p-5 h-full bg-cover gap-3 
							rounded-[calc(1.5rem_-_0.125rem)] flex flex-col items-start justify-center ">
								<Image
									src={img}
									alt={title}
									class="w-auto object-cover rounded-lg"
									transition:name={`img-${id}`}
									widths={[340, 680]}
									sizes="(min-width: 768px) 276px, calc(100vw - 132px)"
								/>
							    		<h3 class="text-xl">{title}</h3>
					    		<p>{description}</p>
								<div class="flex items-center gap-3">
 									 {technologies.map((technology) => (
										<Icon
										name={technology}
										title={technology}
										size={30}
										class="text-current"
										/>
									))}
								</div>
								<div class="flex justify-around w-full mt-auto">
									<a href={link} target="_blank" class="bg-blue-600 px-3 py-1 rounded-lg font-bold hover:bg-blue-900 ease-in-out duration-">
									Visit site <Icon name="link-icon" class="inline align-super" size={12}/>
									</a>
									<a href={`./projects/${id}`} class="bg-blue-600 px-3 py-1 rounded-lg font-bold hover:bg-blue-900 ease-in-out duration-100">More info <Icon name="link-icon" class="inline align-super" size={12}/></a>
								</div>
								
                        	</div>
						</article>
					)
				})
			}
		</div>
	</section>
</main>
</Layout>
