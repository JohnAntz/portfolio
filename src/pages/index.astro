---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection("projects")

---

<Layout title="Home">
<main class="mx-auto w-full max-w-3xl px-6 py-12 gap-10 flex flex-col items-center">
	<section class="hero">
		<p class="text-blue-700 text-lg md:text-4xl">Hello, I'm</p>
		<h1 class="text-4xl md:text-7xl">John Antzoulis</h1>
		<p class=" text-sm md:text-xl">Full-stack web developer based in Spain</p>		
	</section>
	<section class="flex flex-col items-center">
		<h1>Selected work</h1>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-10 p-5 justify-items-center">
			{
				projects.map(project => {
					const { id, data } = project
					const { title, description, img, link } = data
						return (
						<div class="bg-linear-to-r from-blue-700 from-15% via-transparent via-50% to-transparent to-85%  rounded-3xl p-0.5 shadow-[0_0_10px_4px_#1447e6]/30 max-w-sm w-full ">
							<div class="bg-slate-950 p-5 h-full bg-cover gap-2 rounded-[calc(1.5rem_-_0.125rem)] flex flex-col items-start justify-center ">
                            	<img src={img} alt={title} class=" w-auto  object-cover rounded-lg"/>
					    		<h3 class="text-xl">{title}</h3>
					    		<p>{description}</p>
								<a href={link} target="_blank" class="underline">Visit the site</a>
                        	</div>
						</div>
					)
				})
			}
		</div>
	</section>
</main>
</Layout>
