---
import { Icon } from "astro-icon/components";

const techStack = [
  { name: "HTML", icon: "html" },
  { name: "CSS", icon: "css" },
  { name: "JavaScript", icon: "javascript" },
  { name: "Astro", icon: "astro" },
  { name: "React", icon: "react" },
  { name: "Express.js", icon: "express" },
  { name: "Tailwind", icon: "tailwind" },
  { name: "Wordpress", icon: "wordpress" },
  { name: "Bash", icon: "bash" },
  { name: "Java", icon: "java" },
  { name: "PostreSQL", icon: "postgres" },
  { name: "MySQL", icon: "mysql" },
];
---

<ul class="grid grid-cols-3 md:grid-cols-4 gap-3 md:gap-6">
  {techStack.map((tech) => (
    <li class="bg-linear-to-r from-blue-700 from-15% via-transparent via-50% to-transparent to-85% rounded-2xl p-0.5
               shadow-[0_0_6px_2px_#1447e6]/30 md:shadow-[0_0_10px_4px_#1447e6]/30
               hover:scale-105 ease-in-out duration-100">
      <div class="bg-slate-950 h-full flex flex-col items-center gap-3 p-2 md:p-5 rounded-[calc(1rem_-_0.125rem)]">
        <Icon name={tech.icon} class="size-7 md:size-11" />
        <span class="text-sm md:text-base">{tech.name}</span>
      </div>
    </li>
  ))}
</ul>