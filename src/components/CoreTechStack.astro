---
import { Icon } from "astro-icon/components";

const techStack = [
  { name: "HTML", icon: "html" },
  { name: "CSS", icon: "css" },
  { name: "TypeScript", icon: "typescript" },
  { name: "React", icon: "react" },
  { name: "Node.js", icon: "node" },
  { name: "PostreSQL", icon: "postgres" },
];
---

<main class="flex flex-col items-center gap-3 md:gap-6">
  <ul class="grid grid-cols-3 gap-3 md:gap-6">
    {techStack.map((tech) => (
      <li class="bg-linear-to-r from-blue-700 from-15% via-transparent via-50% to-transparent to-85% rounded-2xl p-0.5 shadow-[0_0_6px_2px_#1447e6]/30 md:shadow-[0_0_10px_4px_#1447e6]/30">
        <div class="bg-slate-950 h-full flex flex-col items-center gap-3 p-2 md:p-5 rounded-[calc(1rem_-_0.125rem)]">
          <Icon name={tech.icon} class="size-7 md:size-11" />
          <span class="text-sm md:text-base">{tech.name}</span>
        </div>
      </li>
    ))}
  </ul>
  <a aria-label="Redirect to technologies page" href="/Technologies" class="bg-blue-700 px-2 py-1 rounded-md text-white text-sm md:text-xl md:px-4 md:py-2 md:rounded-lg hover:bg-blue-900 ease-in-out duration-100">Complete stack <Icon name="link-icon" class="inline align-super" size={12}/></a>
</main>