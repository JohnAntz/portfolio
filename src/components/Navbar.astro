---
import { Icon } from 'astro-icon/components';
---
<nav class="p-6 mx-auto w-full max-w-3xl z-10 relative">
  <div class="relative flex justify-between items-center ">
    <a href="/" class="text-blue-700" aria-label="John Antzoulis logo"><Icon  name="logo" size={70}  /></a>
    <div >
      <button class="toggle relative z-20 md:hidden">
        <span><Icon class="open-icon" name="menu" size={40} /></span>
        <span><Icon class="close-icon hidden" name="menu-close" size={40} /></span>
      </button>
      <div class="menu hidden absolute top-10 right-2 p-6 rounded-xl flex flex-col  gap-6 text-2xl bg-black/85 transition-discrete duration-50 ease-in-out  md:flex  md:relative md:top-auto md:right-auto md:flex-row ">
        <a href="/" class="hover:text-blue-700">Home</a>
        <a href="/projects" class="hover:text-blue-700">About</a>
        <a href="/blog" class="hover:text-blue-700">Blog</a>
        <a href="/contact" class="hover:text-blue-700">Contact</a>
      </div>
    </div>
    
  </div>
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector(".toggle");
    const menu = document.querySelector(".menu");
    const openMenu = document.querySelector(".open-icon");
    const closeMenu = document.querySelector(".close-icon");

    button?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
      openMenu?.classList.toggle("hidden");
      closeMenu?.classList.toggle("hidden");
    });
  });
</script>