---
import { Icon } from 'astro-icon/components';
---
<nav class=" p-6 rounded-lg">
  <div class="container relative flex justify-between items-center mx-auto text-slate-200">
    <a href="/" ><Icon  name="logo" size={60} /></a>
    <div >
      <button class="toggle md:hidden">
        <span><Icon class="open-icon" name="menu" size={40} /></span>
        <span><Icon class="close-icon hidden" name="menu-close" size={40} /></span>
      </button>
      <div class="menu hidden absolute top-6 left-1/2 -translate-x-1/2 flex flex-col  gap-6 text-2xl opacity-0 transition-all transition-discrete duration-100 ease-in-out starting:opacity-0 [&:not(.hidden)]:opacity-100 md:flex  md:opacity-100 md:relative md:flex-row ">
        <a href="/" class="hover:text-blue-500">Home</a>
        <a href="/projects" class="hover:text-blue-500">About</a>
        <a href="/blog" class="hover:text-blue-500">Blog</a>
        <a href="/contact" class="hover:text-blue-500">Contact</a>
      </div>
    </div>
    
  </div>
</nav>

<script>
  const button = document.querySelector(".toggle");
  const menu = document.querySelector(".menu");
  const openMenu = document.querySelector(".open-icon")
  const closeMenu = document.querySelector(".close-icon")
  button?.addEventListener('click', () => {
    menu?.classList.toggle("hidden");
    openMenu?.classList.toggle("hidden");
    closeMenu?.classList.toggle("hidden");

  });
</script>