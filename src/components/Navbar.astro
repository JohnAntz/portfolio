---
import { Icon } from 'astro-icon/components';
---
<nav class=" p-6 rounded-lg">
  <div class="container relative flex justify-between items-center mx-auto text-slate-200">
    <a href="/"><Icon name="logo" size={60} /></a>
    <button  class=" toggle p-2 rounded-full bg-blue-500 text-white hover:bg-blue-700 focus:outline-none focus-visible:ring">Toggle</button>
    <div   class="menu hidden absolute top-6 left-1/2 -translate-x-1/2 flex flex-col  gap-6 text-2xl">
      <a href="/" class="hover:text-blue-500">Home</a>
      <a href="/projects" class="hover:text-blue-500">About</a>
      <a href="/blog" class="hover:text-blue-500">Blog</a>
      <a href="/contact" class="hover:text-blue-500">Contact</a>
    </div>
    
  </div>
</nav>

<script>
  const button = document.querySelector(".toggle");
  const menu = document.querySelector(".menu");
  button?.addEventListener('click', () => {
    menu?.classList.toggle("hidden")
  });
</script>