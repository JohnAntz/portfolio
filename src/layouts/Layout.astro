---
import "../styles/global.css";
import Navbar from '../components/Navbar.astro';
import "@fontsource-variable/onest"
import { ClientRouter } from "astro:transitions";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<ClientRouter/>
	</head>
	<body class="flex min-h-screen flex-col text-slate-200 pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)]">
		<div class="fixed inset-0 -z-10 h-lvh items-center px-5 py-24 [background:radial-gradient(125%_125%_at_50%_10%,#000_50%,#1447e6_100%)]"></div>
		  <!-- Safari 26 bar tint sources -->
		<div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[3px] bg-black"></div>
		<div class="pointer-events-none fixed inset-x-0 -bottom-0.5 z-50 h-[3px] bg-[#091f65]"></div>
		<Navbar />
		<slot />
		<footer class="mt-auto w-full py-6 text-center text-slate-400">
    		&copy; JohnAntz 2026
  		</footer>
		
	</body>

</html>




